{
  "name": "aiwrap-relay",
  "version": "0.1.1",
  "private": true,
  "description": "macOS wrapper for Codex and Claude with RTK and Hindsight MCP integration",
  "type": "module",
  "bin": {
    "aiwrap": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm,cjs --target node20 --platform node --out-dir dist --clean",
    "build:binary": "npm run build && pkg dist/cli.cjs --targets node20-macos-arm64,node20-macos-x64 --out-path binaries",
    "vendor:hindsight": "node scripts/vendor-hindsight-mcp.mjs",
    "build:hindsight-binary": "npm run vendor:hindsight && node scripts/package-hindsight-binary.mjs",
    "package:release": "node scripts/package-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@yao-pkg/pkg": "^6.14.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
